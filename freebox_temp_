#!/usr/bin/env python3
"""Plugin Munin pour les temperatures de la Freebox."""
import hashlib
import hmac
import json
import os
import re
import sys
import time

import requests

APP_ID = "fr.fbxstat.app"
APP_NAME = "FbxStat"
APP_VERSION = "1.0"
DEVICE_NAME = "fbxstat"
TOKEN_FILE = "/etc/munin/fbxstat_token.json"
BASE_URL = "http://mafreebox.freebox.fr/api/v8"


def register_app():
    resp = requests.post(f"{BASE_URL}/login/authorize/", json={
        "app_id": APP_ID,
        "app_name": APP_NAME,
        "app_version": APP_VERSION,
        "device_name": DEVICE_NAME,
    }).json()["result"]
    app_token, track_id = resp["app_token"], resp["track_id"]

    sys.stderr.write("Valide la demande sur l'ecran de la Freebox...\n")
    while True:
        status = requests.get(f"{BASE_URL}/login/authorize/{track_id}").json()["result"]["status"]
        if status == "granted":
            break
        if status in ("denied", "timeout"):
            raise RuntimeError(f"Autorisation refusee ({status})")
        time.sleep(1)

    with open(TOKEN_FILE, "w") as f:
        json.dump({"app_token": app_token}, f)
    return app_token


def get_app_token():
    if os.path.exists(TOKEN_FILE):
        with open(TOKEN_FILE) as f:
            return json.load(f)["app_token"]
    return register_app()


def open_session(app_token):
    challenge = requests.get(f"{BASE_URL}/login/").json()["result"]["challenge"]
    password = hmac.new(app_token.encode(), challenge.encode(), hashlib.sha1).hexdigest()
    resp = requests.post(f"{BASE_URL}/login/session/", json={
        "app_id": APP_ID,
        "password": password,
    }).json()
    if not resp["success"]:
        raise RuntimeError(f"Login echoue: {resp}")
    return resp["result"]["session_token"]


def field_id(name):
    short = re.sub(r"^temp[eé]rature\s*", "", name.lower())
    short = re.sub(r"[^a-z0-9]", "", short)
    return "temp_" + short if short else "temp"


def get_sensors(session_token):
    data = requests.get(f"{BASE_URL}/system/", headers={"X-Fbx-App-Auth": session_token}).json()
    return data["result"].get("sensors", [])


def print_config(sensors):
    print("graph_title Freebox temperatures")
    print("graph_vlabel °C")
    print("graph_category sensors")
    for s in sensors:
        fid = field_id(s["name"])
        print(f"{fid}.label {s['name']}")
        print(f"{fid}.type GAUGE")


def print_values(sensors):
    for s in sensors:
        print(f"{field_id(s['name'])}.value {s['value']}")


def main():
    app_token = get_app_token()
    session_token = open_session(app_token)
    sensors = get_sensors(session_token)

    if len(sys.argv) > 1 and sys.argv[1] == "config":
        print_config(sensors)
    else:
        print_values(sensors)


if __name__ == "__main__":
    main()
